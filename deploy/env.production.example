# Copy to ../.env.production and fill in. That file holds live secrets — it is
# gitignored, and it should never be baked into an image.
#
#   cp deploy/env.production.example .env.production
#   python scripts/check_production_config.py     # before every deploy

# ---------- environment ----------
# "production" turns on the strict checks in config.assert_production_ready and
# closes /docs, /redoc and /openapi.json. The app refuses to start if anything
# below is still at a development default.
ENVIRONMENT=production

# ---------- secrets ----------
# Session tokens are HMAC-SHA256 signed with this. Anyone holding it can mint a
# token for any account, so it must be random and it must not be shared with
# any other environment. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=

# ---------- who may call the API ----------
# The site's own origin(s), comma separated. Not "*": credentials are allowed,
# so a wildcard lets any site call this API as a signed-in user.
CORS_ORIGINS=https://locswap.example.com

# ---------- the model ----------
# Same provider as development, so the prompts need no re-validation. Pick a
# server region the model serves: Hong Kong is refused (see deploy/README.md).
LLM_PROVIDER=openai_compat
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL_MAIN=openai/gpt-5.6-terra
LLM_MODEL_LIGHT=openai/gpt-5.6-terra

# ---------- embeddings ----------
# Explicit, never "auto". The model is baked into the image; if it is somehow
# missing, this makes startup fail instead of quietly switching to the hashing
# encoder, which keeps search answering with much worse results and logs only a
# warning.
EMBEDDING_BACKEND=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ---------- vector store ----------
# Chroma: a local directory, no network, no credentials, no service to keep up.
#
# Milvus was the plan and the code for it is written and verified
# (MilvusVectorStore, scripts/verify_milvus.py).
# It is not used here because at this size it buys nothing and costs latency:
# the two backends returned *identical* results over 40 queries — top-1 40/40,
# overlap@20 1.0000, scores within 3.6e-07 — at 6.6 ms (Chroma, local) against
# 101 ms (Zilliz, measured from the US east coast; Hong Kong to GCP us-west1 is
# further). That round trip sits on the buyer search path, which is deliberately
# LLM-free precisely so it can be fast.
#
# Switch back with VECTOR_BACKEND=milvus plus MILVUS_URI / MILVUS_TOKEN /
# MILVUS_COLLECTION_PREFIX when there is a reason to: several app servers
# sharing one index, or a corpus past roughly ten thousand items.
VECTOR_BACKEND=chroma
# Inside the mounted volume, so it outlives the container. Losing it is not
# fatal either way — the index is rebuilt from SQLite on every start.
# 512-dim collection since the 2026-09-15 switch to bge-small-zh; a
# directory built by the 384-dim English model cannot be reused.
CHROMA_DIR=/app/data/chroma_zh

# ---------- data ----------
# Inside the container these point at the mounted volume; leave them alone
# unless the compose file changes too.
DATA_DIR=/app/data
DB_URL=sqlite:////app/data/locswap.db
