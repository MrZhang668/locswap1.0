# ============================================================
# 智能寻物平台 Demo — 全部配置项
# 复制为项目根目录下的 .env 后按需修改
# ============================================================

# ---------- 基础 ----------
APP_NAME=LocSwap
# 所有运行时数据（sqlite / chroma / 上传图片）都放在这里
DATA_DIR=data
# 业务库（Repository 层已抽象，换 Postgres 只需改这一行 + 装驱动）
DB_URL=sqlite:///data/locswap.db
# demo 级签名密钥，生产必须替换
AUTH_SECRET=dev-only-change-me
AUTH_TOKEN_EXPIRE_HOURS=168
# 后端允许的前端来源
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- 状态机 / 业务常量 ----------
# 卖家确认窗口（小时）。倒计时 UI 与过期轮询读同一个常量
CONFIRM_WINDOW_HOURS=24
# 注册引导里"发货范围"的默认值（km）
DEFAULT_PICKUP_RANGE_KM=3.0
# 过期轮询间隔（秒）
EXPIRY_POLL_INTERVAL_SECONDS=60

# ---------- LLM ----------
# 服务商：anthropic = Anthropic 官方 SDK；openai_compat = 任何 OpenAI 兼容接口
# （OpenRouter / 各类中转站）。不填 key 则所有 LLM 调用点降级：
# 上架走"卖家手填"提示，查询理解直接走三路召回，销售顾问返回降级提示
LLM_PROVIDER=anthropic
# openai_compat 必填：接口基地址，例如 https://openrouter.ai/api/v1
LLM_BASE_URL=
# openai_compat 用的 key；留空时回退到 ANTHROPIC_API_KEY
LLM_API_KEY=
ANTHROPIC_API_KEY=
# 模型名一律走环境变量，代码中不硬编码。Anthropic 官方用 claude-*；
# OpenRouter 用带厂商前缀的完整 slug，例如 openai/gpt-5.6-terra
LLM_MODEL_MAIN=claude-sonnet-4-6
LLM_MODEL_LIGHT=claude-haiku-4-5
# Intent router (call site D). Empty -> LLM_MODEL_LIGHT. It runs on every
# turn and only classifies, so keep it on a cheap model.
LLM_MODEL_ROUTER=
# 调用点 A：上架内容生成
LLM_MAX_TOKENS_LISTING=800
LLM_TEMPERATURE_LISTING=0.2
# 调用点 B：查询结构化 / 追问
LLM_MAX_TOKENS_QUERY=300
LLM_TEMPERATURE_QUERY=0.0
# schema 校验失败后的自动重试次数
LLM_JSON_RETRIES=1
# 单次请求超时（秒）
LLM_TIMEOUT_SECONDS=60

# ---------- 卖家销售顾问（调用点 C，库存房对话式顾问）----------
# 不填 ANTHROPIC_API_KEY 时顾问接口降级为固定提示，三个只读工具仍可独立运行
LLM_MAX_TOKENS_SELLER_ADVISOR=1500
LLM_TEMPERATURE_SELLER_ADVISOR=0.3
# 一次请求最多几轮模型调用（每轮可能带工具调用）
SELLER_ADVISOR_MAX_TOOL_ROUNDS=4
# 单轮响应里最多执行几个工具调用
SELLER_ADVISOR_MAX_TOOL_CALLS_PER_ROUND=3
# 聊天上下文只保留最近几轮（1 轮 = 用户 + 顾问各一条）
SELLER_ADVISOR_HISTORY_TURNS=6
# find_potential_buyers 的 top_n 服务端上限
SELLER_ADVISOR_TOP_N_MAX=5
# analyze_sold_prices 最多读多少条成交证据
SELLER_ADVISOR_EVIDENCE_LIMIT=30

# ---------- Embedding（本地，不消耗 API token）----------
# auto = 优先 sentence-transformers，装不上/下不动就退化到内置 hashing 编码器
# 可选：auto | sentence_transformers | hashing
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# hashing 兜底编码器的维度
EMBEDDING_FALLBACK_DIM=512
# bge 系列检索任务建议给 query 加前缀；换成 all-MiniLM-L6-v2 时置空
EMBEDDING_QUERY_PREFIX="为这个句子生成表示以用于检索相关文章："

# ---------- 向量库 ----------
# chroma = 本地持久化；memory = 纯内存兜底（chromadb 不可用时自动切换）
VECTOR_BACKEND=chroma
CHROMA_DIR=data/chroma_zh
CHROMA_COLLECTION=items

# Milvus / Zilliz Cloud（VECTOR_BACKEND=milvus 时才用）。
# 同样两个值也能指向自托管 Milvus：URI=http://localhost:19530，TOKEN 留空。
# 连不上会降级到内存向量库 —— 那是空的，会让每次搜索都返回空，注意看启动日志。
MILVUS_URI=
MILVUS_TOKEN=
# 单次 RPC 超时（秒）。serverless 集群休眠后第一次唤醒要几十秒，太短会被当成"后端不可用"。
MILVUS_TIMEOUT_S=30
MILVUS_CONNECT_ATTEMPTS=3
# Strong = 写入对下一次搜索立即可见（Chroma 没有可见性延迟，保持一致才好换）。
MILVUS_CONSISTENCY=Strong

# ---------- 检索管线 ----------
# 三路召回各取多少条
RECALL_TOP_K=20
# RRF 融合后返回多少条
FINAL_TOP_K=8
# RRF 常数 k
RRF_K=60
# 融合后 top1 归一化置信度低于此值 → 触发追问（0~1）
RETRIEVAL_MIN_CONFIDENCE=0.25
# --- 三路各自的有效命中门槛（见 README 检索管线一节）---
# 向量路：绝对余弦下限
# 在中文语料（644 件）+ bge-small-zh-v1.5 上标定（2026-09-15）：
#   正例落在 0.420~0.708（中位 0.564），负例 0.321~0.481（洗衣机 .448、打印机 .450、显卡 .481）。
#   0.50 挡住全部负例；低于它的正例是口语化表达，由另外两路召回兜住。
#   与 backend/app/config.py 的默认值一致。换语料/换模型需要重新标定。
VECTOR_MIN_SIMILARITY=0.50
# 向量路：只保留与最优命中相差不超过这个值的候选
VECTOR_RELATIVE_WINDOW=0.15
# 关键词路：BM25 绝对分数下限（jieba 分词；中文负例得分为 0，门槛只需低于最低真实命中 5.53）
BM25_MIN_SCORE=5.0
# 关键词路：相对最优命中的比例下限
BM25_RELATIVE_CUTOFF=0.30
# 结构化路：相对最优命中的比例下限
STRUCTURED_RELATIVE_CUTOFF=0.7
# 三路召回开关，用于召回对比调优（关掉某一路看指标变化）
ENABLE_VECTOR_RECALL=true
ENABLE_BM25_RECALL=true
ENABLE_STRUCTURED_RECALL=true
# AI 追问最多几轮
MAX_CLARIFY_ROUNDS=1
# 聊天上下文只带最近几轮
CHAT_HISTORY_TURNS=4
# 把每次检索的完整调试信息打到后端日志
RETRIEVAL_DEBUG_LOG=true

# ---------- 图片 ----------
IMAGE_MAX_EDGE=1024
IMAGE_JPEG_QUALITY=85

# ---------- 求购意图（want）----------
# 检索未满足时自动沉淀买家需求，新品上架时反向匹配并通知。全程零 LLM。
WANT_ENABLED=true
# 一条 want 多久后自动过期（校园二手的需求半衰期短，挂太久会产生噪声匹配）
WANT_TTL_DAYS=14
# want 的向量集合名（与商品的 items 集合分开）
WANT_VECTOR_COLLECTION=wants
# 单个买家每天最多被推送几次“有货了”通知
WANT_MAX_NOTIFY_PER_DAY=3
# 单条 want 的推送总次数上限
WANT_MAX_NOTIFY_TOTAL=5

# ---------- want ↔ item 匹配门槛 ----------
# 刻意与 VECTOR_MIN_SIMILARITY 分开。后者标定的是 query → item（短 query 对长商品文档），
# 这里管的是 item → want：拿商品文档当 query 去撞 want 向量，两侧的文本长度、前缀、句式
# 都不同，两个分布不重合，共用一条线本来就是巧合而非设计。
# 0.53 有实测依据，但样本很小，算工作值而非标定值。实测：
#   正例 0.586（"I want to buy a book" 对水彩本）、0.527（"notebook" 对同一件）
#   负例 0.523（"printer" 对水彩本）、0.515（"used bike" 对机械键盘 —— 最典型的噪声）
# 两类几乎贴在一起，所以 0.53 是刻意偏向精确率：给卖家看一个不相干的买家，
# 比漏掉一个真买家代价更大。正式用之前请先跑一遍扫描。
WANT_MATCH_MIN_SIMILARITY=0.53
WANT_MATCH_RELATIVE_WINDOW=0.15
# E2 的反向查库存（"顺便一提，有件 X 可能合适"）是给买家看的，而且是 query→item 形状，
# 和买家检索完全一样 —— 所以它跟随 VECTOR_MIN_SIMILARITY，不是 WANT_MATCH_MIN_SIMILARITY。
# 实测：用 0.53 时它会拿滑板回答 kayak、拿串灯回答一句乱码。
# 留空则跟随 VECTOR_MIN_SIMILARITY；填数值可单独收紧这一个出口。
# WANT_STOCK_HINT_MIN_SIMILARITY=
